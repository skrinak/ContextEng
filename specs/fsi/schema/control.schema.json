{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skrinak/ContextEng/specs/fsi/schema/control.schema.json",
  "title": "Layer 3: a control (how an obligation is implemented and proved)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "satisfies", "implementation", "evidence", "aws", "confidence", "verified", "review_due"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["technical", "organizational"]},
    "satisfies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}},
    "implementation": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limits": {"type": "string"},
    "aws": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "configuration", "doc"],
        "properties": {
          "service": {"type": "string", "minLength": 1},
          "configuration": {"type": "string", "minLength": 1},
          "doc": {"$ref": "common.schema.json#/$defs/url"},
          "quote": {"type": "string", "minLength": 20}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "verified": {"$ref": "common.schema.json#/$defs/verified"},
    "review_due": {"$ref": "common.schema.json#/$defs/date"}
  }
}
